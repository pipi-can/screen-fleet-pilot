// ═══════════════════════════════════════════════════════════════
// 硬件健康数据读取
// ═══════════════════════════════════════════════════════════════

QString NetworkManager::readCpuTemp()
{
    // ARM: /sys/class/thermal/thermal_zone0/temp
    QFile file("/sys/class/thermal/thermal_zone0/temp");
    if (file.open(QIODevice::ReadOnly | QIODevice::Text)) {
        QTextStream in(&file);
        int tempMilli = in.readLine().toInt();
        file.close();
        return QString::number(tempMilli / 1000.0, 'f', 1) + "C";
    }
    // x86 fallback
    return "N/A";
}

int NetworkManager::readMemUsage()
{
    QFile file("/proc/meminfo");
    if (!file.open(QIODevice::ReadOnly | QIODevice::Text))
        return -1;

    QString content = QString::fromUtf8(file.readAll());
    file.close();

    long total = 0, available = 0;
    const QStringList lines = content.split('\n');
    for (const QString& line : lines) {
        if (line.startsWith("MemTotal:")) {
            total = line.split(QRegExp("\\s+"))[1].toLong();
        } else if (line.startsWith("MemAvailable:")) {
            available = line.split(QRegExp("\\s+"))[1].toLong();
        }
    }

    if (total == 0) return -1;
    return static_cast<int>(100 - (available * 100 / total));
}

int NetworkManager::readDiskFreeMb()
{
    struct statvfs stat;
    if (statvfs("/", &stat) != 0)
        return -1;

    unsigned long freeMb = (stat.f_bavail * stat.f_frsize) / (1024 * 1024);
    return static_cast<int>(freeMb);
}
